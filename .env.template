# ============================================================
# Construction API — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
# ============================================================

# Application
NODE_ENV=development
PORT=3000

# Zoho Inventory
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_ORG_ID=

# Firebase Admin SDK
# Value can be either:
#   a) A JSON string:     FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
#   b) An absolute path:  FIREBASE_SERVICE_ACCOUNT=/run/secrets/firebase-sa.json
FIREBASE_SERVICE_ACCOUNT=

# Admin Portal
# ADMIN_PASSWORD must be at least 8 characters
# ADMIN_TOKEN must be at least 16 characters
ADMIN_PASSWORD=
ADMIN_TOKEN=

# Live orders (admin portal RTDB push) — required for the real-time orders view.
# FIREBASE_DATABASE_URL: the project's Realtime Database URL (also used by the API).
# FIREBASE_WEB_API_KEY / FIREBASE_AUTH_DOMAIN: Firebase Web app config, served to
# the admin portal so it can signInWithCustomToken and subscribe to liveOrders.
# (AUTH_DOMAIN defaults to <projectId>.firebaseapp.com if omitted.)
FIREBASE_DATABASE_URL=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Google Maps (optional — used for geocoding and ETA)
GOOGLE_MAPS_API_KEY=
WAREHOUSE_LAT=12.863326
WAREHOUSE_LNG=80.226196

# Cloudinary (optional — used for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis (optional — omit to disable distributed cache)
# Create a free database at console.upstash.com, region ap-south-1 (Mumbai)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Slack (optional — post/edit order messages + payment-failure alerts)
# Create a Slack app, add bot scope chat:write, install to workspace, then
# invite the bot to the target channel. SLACK_CHANNEL_ID is the channel's ID
# (e.g. C0123ABCD), not its name.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Optional: separate channel for warehouse open/close broadcasts. Leave unset to
# post them into SLACK_CHANNEL_ID alongside order cards (the current setup). Set
# this to a channel ID (e.g. C0123ABCD, not a name) to split them out, and invite
# the bot to that channel.
SLACK_BROADCAST_CHANNEL_ID=

# Cloud Scheduler OIDC auth for the warehouse schedule tick
# (POST /api/v1/config/warehouse-schedule-tick). The scheduler presents a
# Google-signed identity token for this service account instead of an admin token.
# The endpoint refuses ALL callers while this is unset (closed, not open).
# Prod needs no manual step: deploy.sh derives the value, creates the service
# account, and injects it via --set-env-vars. Set it here only for a local run.
SCHEDULER_SERVICE_ACCOUNT_EMAIL=
# Optional: overrides the expected OIDC audience, which otherwise defaults to
# this service's own URL. Only needed behind a custom domain or proxy.
SCHEDULER_OIDC_AUDIENCE=

# Grafana Cloud OTLP (optional — omit to send to local Jaeger/Collector on port 4318)
GRAFANA_USER=
GRAFANA_API_KEY=
OTLP_ENDPOINT=https://otlp-gateway-prod-ap-south-1.grafana.net/otlp
